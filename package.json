{
  "name": "lunarchain-landing",
  "version": "0.0.0",
  "engines": {
    "node": ">=20.10.0 <21",
    "npm": ">=10 <11"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:dev": "ng serve --configuration=development",
    "start:prod": "ng serve --configuration=production",
    "start:local": "ng serve --configuration=local",
    "build": "ng build",
    "build:dev": "ng build --configuration=development",
    "build:prod": "ng build --configuration=production",
    "build:local": "ng build --configuration=local",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:LunarSurface": "node dist/lunar-surface/server/server.mjs",
    "deploy:dev": "npm run build:dev && npx firebase-tools@13.35.1 deploy --only hosting --project lunarchain --config firebase.json",
    "deploy:qa": "npm run deploy:dev",
    "deploy:prod": "npm run build:prod && npx firebase-tools@13.35.1 deploy --only hosting --project lunarchain --config firebase.json"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.0.0",
    "@angular/cdk": "^17.0.1",
    "@angular/common": "^17.0.0",
    "@angular/compiler": "^17.0.0",
    "@angular/core": "^17.0.0",
    "@angular/forms": "^17.0.0",
    "@angular/material": "^17.0.1",
    "@angular/platform-browser": "^17.0.0",
    "@angular/platform-browser-dynamic": "^17.0.0",
    "@angular/platform-server": "^17.0.0",
    "@angular/router": "^17.0.0",
    "@angular/ssr": "^17.0.1",
    "@swimlane/ngx-charts": "^22.0.0",
    "@types/d3": "^7.4.3",
    "ag-charts-angular": "^10.1.0",
    "chart.js": "^4.4.6",
    "d3": "^7.9.0",
    "echarts": "^5.6.0",
    "express": "^4.18.2",
    "gsap": "^3.13.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.0",
    "leaflet": "^1.9.4",
    "marked": "^9.1.6",
    "ng2-charts": "^5.0.4",
    "ngx-echarts": "^19.0.0",
    "ngx-markdown": "^17.0.0",
    "prismjs": "^1.30.0",
    "rxjs": "~7.8.0",
    "three": "^0.170.0",
    "three-globe": "^2.44.0",
    "topojson-client": "^3.1.0",
    "tslib": "^2.3.0",
    "ws": "^8.14.2",
    "zone.js": "~0.14.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.0.1",
    "@angular/cli": "^17.0.1",
    "@angular/compiler-cli": "^17.0.0",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-shape": "^3.1.7",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^18.18.0",
    "@types/three": "^0.180.0",
    "@types/topojson-client": "^3.1.5",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.2.2"
  }
